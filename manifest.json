{
  "schema": 2, 
  "permissions": ["tools.invoke"],
  "required_executas": [
    {
      "tool_id": "tool-dev-mini-notes"
    }
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "mini-notes",
        "default": true,
        "default_size": { "w": 960, "h": 640 },
        "min_size": { "w": 480, "h": 360 }

      }
    ],
    "host_api": {
      "tools": ["required:*"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
